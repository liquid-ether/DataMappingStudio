<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\App.Domain\App.Domain.csproj" />
    <ProjectReference Include="..\App.Application\App.Application.csproj" />
    <ProjectReference Include="..\App.Infrastructure.Local\App.Infrastructure.Local.csproj" />
    <ProjectReference Include="..\App.Infrastructure.Remote\App.Infrastructure.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClosedXML comes transitively via App.Infrastructure.Local (the ClosedXmlWorkbookReader). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the importer's config and the canonical worksheet→table mapping next to the executable so
         it runs self-contained (the mapping is the editable build/import-mapping.json). -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\import-mapping.json" Link="import-mapping.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
