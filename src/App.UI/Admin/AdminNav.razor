    <NavLink href="admin/providers" ActiveClass="active" Match="NavLinkMatch.Prefix">@(Lang.IsFrench ? "Fournisseurs" : "Providers")</NavLink>
    <NavLink href="admin/audit" ActiveClass="active" Match="NavLinkMatch.Prefix">@(Lang.IsFrench ? "Journal" : "Audit")</NavLink>
</nav>
