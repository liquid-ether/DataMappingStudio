@inject DataImportState State
@inject LanguageState Lang
@implements IDisposable
@using App.UI.DataImport
@using App.Application.Importing
@using Microsoft.AspNetCore.Components.Forms

@* Data Import wizard — wired to the real local database. Every worksheet of an uploaded .xlsx is parsed
   by the shared workbook reader, mapped to catalog tables in the editable Mapping step (prefilled from
   the built-in template, or from a saved mapping in the shared store), validated against the column
   catalog (dry run), then loaded through the same ImportEngine the CLI uses into the local store as one
   reviewable change set. Mappings saved here are the only ones the CLI can run. *@

<style>
  @@keyframes dbi-spin{to{transform:rotate(360deg)}}
  @@keyframes dbi-fadeup{from{opacity:.4;transform:translateY(6px)}to{opacity:1;transform:none}}
  .dbi{display:flex;flex-direction:column;flex:1;min-height:0;background:var(--bg);color:var(--text);
    font-family:'Inter',system-ui,sans-serif;font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;
    border:1px solid var(--border);border-radius:16px;overflow:hidden;position:relative;box-shadow:0 8px 40px rgba(16,30,40,.10)}
  .dbi *{box-sizing:border-box}
  .dbi .mono{font-family:'JetBrains Mono',ui-monospace,monospace}
  .dbi select,.dbi input{font-family:inherit}
  .dbi .dbi-ell{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dbi-scroll::-webkit-scrollbar{width:10px;height:10px}
  .dbi-scroll::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:8px;border:2px solid transparent;background-clip:padding-box}
  .dbi-fade{animation:dbi-fadeup .22s ease}

  .dbi-head{display:flex;align-items:center;gap:18px;padding:0 22px;height:60px;background:var(--surface);border-bottom:1px solid var(--border);position:relative;z-index:40}
  .dbi-logo{width:30px;height:30px;border-radius:8px;background:var(--accent);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 1px 2px rgba(0,0,0,.18)}
  .dbi-logo i{width:13px;height:13px;border:2.2px solid #fff;border-radius:3px;border-top-color:transparent;transform:rotate(45deg);display:block}
  .dbi-title{font-weight:600;font-size:15px;letter-spacing:-.2px;white-space:nowrap}
  .dbi-badge{font-size:11px;font-weight:500;color:var(--text-3);border:1px solid var(--border);padding:1px 7px;border-radius:20px;white-space:nowrap}
  .dbi-target{display:flex;align-items:center;gap:9px;height:36px;padding:0 12px;background:var(--surface-2);border:1px solid var(--border);border-radius:9px;font-size:12.5px;max-width:280px}
  .dbi-dot-ok{width:7px;height:7px;border-radius:50%;background:var(--ok);flex-shrink:0;box-shadow:0 0 0 3px var(--ok-soft)}

  .dbi-stepper{display:flex;overflow-x:auto;padding:16px 22px;background:var(--surface);border-bottom:1px solid var(--border)}
  .dbi-step{display:flex;align-items:center;gap:9px;padding:7px 13px;border-radius:10px;border:none;background:transparent;cursor:pointer;font-family:inherit}
  .dbi-step.cur{background:var(--surface-2)}
  .dbi-step-dot{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;transition:all .2s}
  .dbi-step-dot.cur{background:var(--accent);color:#fff;box-shadow:0 0 0 4px var(--accent-soft)}
  .dbi-step-dot.done{background:var(--accent-soft);color:var(--accent-text)}
  .dbi-step-dot.idle{background:var(--surface-2);color:var(--text-3);border:1px solid var(--border)}
  .dbi-kicker{font-size:9.5px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--text-3)}
  .dbi-conn-line{width:26px;height:2px;border-radius:2px;flex-shrink:0;display:block}

  .dbi-body{flex:1;overflow:auto;padding:28px 22px 32px;min-height:0}
  .dbi-h1{margin:0 0 5px;font-size:21px;font-weight:600;letter-spacing:-.3px}
  .dbi-sub{margin:0;color:var(--text-2);font-size:13.5px}
  .dbi-foot{flex-shrink:0;z-index:30;display:flex;align-items:center;gap:16px;padding:12px 22px;background:var(--surface);border-top:1px solid var(--border)}
  .dbi-next{display:flex;align-items:center;gap:7px;height:40px;padding:0 20px;border-radius:10px;border:none;background:var(--accent);color:#fff;font-weight:600;font-size:13.5px;cursor:pointer;font-family:inherit;box-shadow:0 1px 2px rgba(0,0,0,.15)}
  .dbi-next:disabled{opacity:.5;cursor:not-allowed}
  .dbi-back{height:40px;padding:0 16px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);font-weight:600;font-size:13.5px;cursor:pointer;font-family:inherit}
  .dbi-back:disabled{opacity:.45;cursor:not-allowed}

  .dbi-card{background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:16px}
  .dbi-card-h{font-weight:600;font-size:13px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .dbi-eyebrow{font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--text-3)}
  .dbi-colhead{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--text-3)}

  .dbi-drop{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:3px;padding:48px 24px;border-radius:16px;border:2px dashed var(--border-strong);background:var(--surface);cursor:pointer;transition:all .15s;position:relative}
  .dbi-drop:hover{border-color:var(--accent);background:var(--accent-soft)}
  .dbi-drop input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}
  .dbi-drop-ic{width:60px;height:60px;border-radius:16px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;margin-bottom:8px}
  .dbi-drop-ic i{width:24px;height:24px;border:2.4px solid var(--accent);border-radius:6px;border-bottom-color:transparent;display:block}
  .dbi-pill{font-size:11px;font-weight:600;color:var(--text-3);border:1px solid var(--border);padding:3px 9px;border-radius:20px}
  .dbi-file{display:flex;align-items:center;gap:14px;background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:14px 16px;margin-bottom:16px}
  .dbi-file-ic{width:42px;height:42px;border-radius:10px;background:var(--ok-soft);display:flex;align-items:center;justify-content:center;color:var(--ok);font-weight:700;font-size:13px;flex-shrink:0}
  .dbi-file-meta{display:flex;gap:14px;color:var(--text-3);font-size:11.5px;margin-top:2px}
  .dbi-x{background:none;border:1px solid var(--border);color:var(--text-2);border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:14px}
  .dbi-prev{border-collapse:collapse;width:100%;font-size:11.5px}
  .dbi-prev th{text-align:left;padding:7px 9px;background:var(--surface-2);color:var(--text-2);font-weight:600;white-space:nowrap;border-bottom:1px solid var(--border)}
  .dbi-prev td{padding:6px 9px;white-space:nowrap;color:var(--text);border-bottom:1px solid var(--border)}
  .dbi-sheet{text-align:left;min-width:210px;flex:1;padding:13px 15px;border-radius:11px;border:1.5px solid var(--accent);background:var(--accent-soft);font-family:inherit;color:var(--text)}
  .dbi-sheet-chk{width:18px;height:18px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700}
  .dbi-tab{display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:9px;border:1px solid var(--border);background:var(--surface);color:var(--text-2);font-weight:600;font-size:13px;cursor:pointer;font-family:inherit}
  .dbi-tab.on{border-color:var(--accent);background:var(--accent-soft);color:var(--accent-text)}
  .dbi-status{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;padding:6px 11px;border-radius:8px}
  .dbi-status.err{color:var(--err);background:var(--err-soft)} .dbi-status.ok{color:var(--ok);background:var(--ok-soft)} .dbi-status.warn{color:var(--warn);background:var(--warn-soft)}
  .dbi-maprow{display:grid;grid-template-columns:1fr 30px 1fr;align-items:center;border-bottom:1px solid var(--border)}
  .dbi-type{font-size:10px;font-weight:600;color:var(--text-3);background:var(--surface-2);padding:1px 6px;border-radius:5px}
  .dbi-fl{font-size:9.5px;font-weight:700;padding:2px 6px;border-radius:5px;white-space:nowrap}
  .dbi-note{display:flex;align-items:center;gap:10px;margin-top:12px;padding:11px 15px;background:var(--info-soft);border-radius:10px;font-size:12px;color:var(--text-2)}
  .dbi-kv{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden}
  .dbi-kv-cell{background:var(--surface);padding:12px 14px}
  .dbi-bigbtn{width:100%;height:50px;border-radius:12px;border:none;background:var(--accent);color:#fff;font-weight:600;font-size:15px;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:9px;box-shadow:0 2px 8px rgba(0,0,0,.16)}
  .dbi-bigbtn:disabled{opacity:.6;cursor:not-allowed}
  .dbi-spin{width:16px;height:16px;border:2.4px solid var(--accent);border-top-color:transparent;border-radius:50%;animation:dbi-spin .7s linear infinite;display:inline-block}
  .dbi-metric{border:1px solid var(--border);border-radius:13px;padding:16px;background:var(--surface)}
  .dbi-log{border-collapse:collapse;width:100%;font-size:12px}
  .dbi-log th{text-align:left;padding:8px 10px;font-weight:600;color:var(--text-3);font-size:11px;text-transform:uppercase;letter-spacing:.4px;background:var(--surface-2)}
  .dbi-log td{padding:8px 10px;border-top:1px solid var(--border)}
  .dbi-okdot{width:24px;height:24px;border-radius:50%;background:var(--ok);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px}
  .dbi-act{display:flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:11px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-weight:600;font-size:13.5px;cursor:pointer;font-family:inherit}
  .dbi-bar{height:10px;background:var(--surface-3);border-radius:6px;overflow:hidden}
  .dbi-bar-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width .15s linear}
  .dbi-act.primary{border:none;background:var(--accent);color:#fff;padding:0 20px}
  .dbi-sel{height:34px;padding:0 10px;border-radius:9px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:12.5px;cursor:pointer;max-width:100%}
  .dbi-in{height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:12.5px;min-width:180px}
  .dbi-tab:disabled{opacity:.5;cursor:not-allowed}
</style>

<div class="dbi">
  @* ===== TOP BAR ===== *@
  <header class="dbi-head">
    <div style="display:flex;align-items:center;gap:11px;min-width:0">
      <div class="dbi-logo"><i></i></div>
      <div class="dbi-title">@T("appTitle")</div>
      <span class="dbi-badge">@T("envBadge")</span>
    </div>
    <div style="flex:1"></div>
    <div class="dbi-target">
      <span class="dbi-dot-ok"></span>
      <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.15;min-width:0">
        <span style="font-size:10px;color:var(--text-3);font-weight:500">@T("target")</span>
        <span style="font-weight:550">@T("targetDb")</span>
      </span>
    </div>
  </header>

  @* ===== STEPPER ===== *@
  <nav class="dbi-stepper dbi-scroll">
    <div style="display:flex;align-items:center;gap:4px;margin:0 auto;flex-shrink:0">
      @for (int i = 0; i < DataImportState.StepCount; i++)
      {
        int idx = i;
        bool done = idx < State.MaxStep && idx != State.Step;
        bool cur = idx == State.Step;
        bool locked = idx > State.MaxStep;
        <button class="dbi-step @(cur ? "cur" : "")" disabled="@locked" aria-current="@(cur ? "step" : null)" @onclick="() => State.GoToStep(idx)" style="@(locked ? "opacity:.55;cursor:not-allowed" : "")">
          <span class="dbi-step-dot @(cur ? "cur" : done ? "done" : "idle")">@(done ? "✓" : (idx + 1).ToString())</span>
          <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2">
            <span class="dbi-kicker">@_kickers[idx]</span>
            <span style="font-size:13px;font-weight:@(cur ? 700 : 600);color:@(cur ? "var(--text)" : locked ? "var(--text-3)" : "var(--text-2)")">@_labels[idx]</span>
          </span>
        </button>
        @if (idx < DataImportState.StepCount - 1)
        {
          <span class="dbi-conn-line" style="background:@(idx < State.MaxStep ? "var(--accent)" : "var(--border)");opacity:@(idx < State.MaxStep ? "0.6" : "1")"></span>
        }
      }
    </div>
  </nav>

  @* ===== BODY ===== *@
  <main class="dbi-body dbi-scroll">
    <div style="max-width:1100px;margin:0 auto">

      @* ---------- STEP 1: SOURCE ---------- *@
      @if (State.Step == 0)
      {
        <div class="dbi-fade">
          <div style="margin-bottom:22px">
            <h1 class="dbi-h1">@T("s1Title")</h1>
            <p class="dbi-sub">@T("s1Sub")</p>
          </div>

          @if (!State.HasFile)
          {
            <label class="dbi-drop" aria-label="@($"{T("dropTitle")} — {T("accepted")}")">
              <InputFile OnChange="OnFile" accept=".xlsx" disabled="@State.Busy" />
              <div class="dbi-drop-ic"><i></i></div>
              @if (State.Busy)
              {
                <div style="display:flex;align-items:center;gap:9px;font-weight:600;font-size:15px"><span class="dbi-spin"></span>@T("reading")</div>
              }
              else
              {
                <div style="font-weight:600;font-size:15px">@T("dropTitle")</div>
                <div style="color:var(--text-2);font-size:13px">@T("dropOr") <span style="color:var(--accent-text);font-weight:600;text-decoration:underline">@T("dropBrowse")</span></div>
                <div style="margin-top:10px;display:flex;gap:7px;align-items:center"><span class="dbi-pill">.xlsx</span><span style="font-size:11px;color:var(--text-3)">@T("accepted")</span></div>
              }
            </label>
            @if (State.ParseError is not null)
            {
              <div class="dbi-status err" role="alert" style="margin-top:14px"><span>⚠</span>@State.ParseError</div>
            }
          }
          else
          {
            WorksheetData? preview = State.PopulatedSheets.FirstOrDefault();
            List<string> previewCols = preview is null ? [] : preview.Rows[0].Keys.Take(6).ToList();
            <div class="dbi-file">
              <div class="dbi-file-ic">XLS</div>
              <div style="flex:1;min-width:0">
                <div class="dbi-ell" style="font-weight:600">@State.FileName</div>
                <div class="mono dbi-file-meta">
                  <span>@DataImportState.FmtSize(State.FileSize)</span>
                  <span>@($"{State.PopulatedSheets.Count()} {T("worksheets").ToLowerInvariant()}")</span>
                  <span>@($"{State.FmtInt(State.TotalRows)} {T("rows")}")</span>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:6px;color:var(--ok);font-size:12px;font-weight:600"><span style="font-size:14px">✓</span>@T("parsed")</div>
              <button class="dbi-x" @onclick="State.ClearFile">✕</button>
            </div>

            <div class="dbi-card" style="margin-bottom:16px">
              <div class="dbi-card-h"><span style="color:var(--accent)">▦</span>@T("worksheets")</div>
              <div style="display:flex;gap:12px;flex-wrap:wrap">
                @foreach (WorksheetVm ws in State.Worksheets())
                {
                  <div class="dbi-sheet" style="@(ws.Table.Length == 0 ? "border-color:var(--border);background:var(--surface)" : "")">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:6px">
                      <span style="font-weight:600;font-size:13px">@ws.Name
                        @if (ws.Table.Length > 0) { <span class="mono" style="font-weight:500;color:var(--accent-text)">@T("mappedTo") @ws.Table</span> }
                        else { <span style="font-weight:500;color:var(--text-3);font-style:italic;font-size:11.5px">@T("notImported")</span> }
                      </span>
                      @if (ws.Table.Length > 0) { <span class="dbi-sheet-chk">✓</span> }
                    </div>
                    <div class="mono" style="font-size:11px;color:var(--text-3)">
                      @($"{State.FmtInt(ws.Rows)} {T("rows")} · {ws.MappedColumns}/{ws.SourceColumns} {T("cols")}")
                      @if (ws.UnmappedHeaders.Count > 0) { <text> · @ws.UnmappedHeaders.Count @T("unmappedCols")</text> }
                    </div>
                  </div>
                }
              </div>
            </div>

            @if (preview is not null)
            {
              <div class="dbi-card">
                <div class="dbi-card-h"><span style="color:var(--accent)">◉</span>@T("preview") · <span class="mono" style="font-weight:500">@preview.Worksheet</span></div>
                <div style="border:1px solid var(--border);border-radius:9px;overflow:hidden">
                  <div style="overflow-x:auto" class="dbi-scroll">
                    <table class="dbi-prev">
                      <thead><tr>@foreach (string c in previewCols) { <th>@c</th> }</tr></thead>
                      <tbody>
                        @foreach (IReadOnlyDictionary<string, string?> row in preview.Rows.Take(5))
                        {
                          <tr>@foreach (string c in previewCols) { <td class="mono">@row.GetValueOrDefault(c)</td> }</tr>
                        }
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            }
          }
        </div>
      }

      @* ---------- STEP 2: MAPPING (editable) ---------- *@
      else if (State.Step == 1)
      {
        SheetMappingDraft? draft = ActiveDraft();
        <div class="dbi-fade">
          <div style="margin-bottom:18px">
            <h1 class="dbi-h1">@T("s2Title")</h1>
            <p class="dbi-sub">@T("s2Sub")</p>
          </div>

          @* Template toolbar: built-in prefill, saved mappings (shared with the CLI), save-as. *@
          <div class="dbi-card" style="margin-bottom:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="dbi-eyebrow">@T("templates")</span>
            <button class="dbi-tab" @onclick="State.LoadBuiltInMapping">@T("builtin")</button>
            @if (State.MappingStoreAvailable)
            {
              IReadOnlyList<SavedMappingInfo> saved = State.SavedMappings();
              @if (saved.Count > 0)
              {
                <select class="dbi-sel" aria-label="@T("savedMappings")" @bind="_savedSelect">
                  <option value="">@T("savedMappings")</option>
                  @foreach (SavedMappingInfo m in saved)
                  {
                    <option value="@m.Name">@m.Name (@m.SavedBy)</option>
                  }
                </select>
                <button class="dbi-tab" disabled="@(string.IsNullOrEmpty(_savedSelect))" @onclick="() => State.LoadSavedMapping(_savedSelect!)">@T("apply")</button>
              }
              <div style="flex:1"></div>
              <input class="dbi-in" placeholder="@T("saveAs")" aria-label="@T("saveAs")" @bind="_saveName" @bind:event="oninput" />
              <button class="dbi-tab" disabled="@(string.IsNullOrWhiteSpace(_saveName) || !State.MappingReady)" @onclick="() => State.SaveMapping(_saveName!)">💾 @T("save")</button>
            }
          </div>
          @if (State.MappingMessage is not null)
          {
            <div class="dbi-status ok" role="status" style="margin-bottom:12px"><span>ⓘ</span>@State.MappingMessage</div>
          }
          @foreach (string err in State.MappingErrors())
          {
            <div class="dbi-status err" role="alert" style="margin-bottom:8px"><span>⚠</span>@err</div>
          }

          <div style="display:flex;align-items:center;gap:10px;margin:14px 0;flex-wrap:wrap">
            @foreach (SheetMappingDraft d in State.Drafts)
            {
              SheetMappingDraft tab = d;
              <button class="dbi-tab @(ReferenceEquals(tab, draft) ? "on" : "")" @onclick="() => _mapSheet = tab.Sheet">
                @tab.Sheet
                @if (tab.IsMapped) { <span class="mono" style="font-size:11px;opacity:.8">→ @tab.Table</span> }
                else { <span style="font-size:11px;opacity:.7;font-style:italic">@T("notImported")</span> }
              </button>
            }
          </div>

          @if (draft is not null)
          {
            <div class="dbi-card" style="margin-bottom:14px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
              <span class="dbi-colhead">@T("targetTable")</span>
              <select class="dbi-sel" aria-label="@T("targetTable")" value="@draft.Table" @onchange="e => State.SetDraftTable(draft, (string?)e.Value ?? string.Empty)">
                <option value="">@T("notImported")</option>
                @foreach (string t in State.AvailableTables)
                {
                  <option value="@t">@t</option>
                }
              </select>
              <span class="mono" style="font-size:11.5px;color:var(--text-3)">@State.FmtInt(draft.RowCount) @T("rows") · @draft.HeaderToColumn.Count/@draft.Headers.Count @T("cols")</span>
              <div style="flex:1"></div>
              @if (draft.Table.Length > 0)
              {
                <span style="font-size:11.5px;color:var(--text-3)">@T("keyHint")</span>
              }
            </div>

            @if (draft.Table.Length > 0)
            {
              <div style="display:grid;grid-template-columns:1fr 30px 1fr;margin-bottom:8px;padding:0 4px">
                <div class="dbi-colhead">◧ @T("source")</div><div></div><div class="dbi-colhead">◨ @T("targetCol")</div>
              </div>

              <div class="dbi-card" style="padding:0;overflow:hidden">
                @foreach (string header in draft.Headers)
                {
                  string h = header;
                  string target = draft.HeaderToColumn.GetValueOrDefault(h, "");
                  ColumnCatalogEntry? entry = target.Length == 0 ? null : State.MappableColumns(draft.Table).FirstOrDefault(c => c.ColumnName == target);
                  <div class="dbi-maprow">
                    <div style="padding:11px 15px;min-width:0">
                      <div class="dbi-ell" style="font-weight:600;font-size:13px;@(target.Length == 0 ? "color:var(--text-3)" : "")">@h</div>
                      @if (SampleFor(draft.Sheet, h) is string sample)
                      {
                        <div class="mono dbi-ell" style="font-size:11px;color:var(--text-3);margin-top:2px">@sample</div>
                      }
                    </div>
                    <div style="display:flex;align-items:center;justify-content:center;font-size:15px;color:@(target.Length == 0 ? "var(--text-3)" : "var(--accent)")">→</div>
                    <div style="padding:11px 15px;display:flex;align-items:center;gap:8px;min-width:0;flex-wrap:wrap">
                      <select class="dbi-sel mono" style="max-width:220px" aria-label="@($"{T("targetCol")} — {h}")" value="@target" @onchange="e => State.SetHeaderColumn(draft, h, (string?)e.Value ?? string.Empty)">
                        <option value="">@T("ignore")</option>
                        @foreach (ColumnCatalogEntry c in State.MappableColumns(draft.Table))
                        {
                          <option value="@c.ColumnName">@c.ColumnName@(c.IsRequired ? " *" : "")</option>
                        }
                      </select>
                      @if (entry is not null)
                      {
                        <span class="dbi-type mono">@entry.ValueType.ToString().ToLowerInvariant()</span>
                        @if (entry.IsRequired) { <span class="dbi-fl" style="color:var(--err);background:var(--err-soft)">@T("required")</span> }
                        @if (draft.References.ContainsKey(entry.ColumnName)) { <span class="dbi-fl" style="color:var(--info);background:var(--info-soft)">@T("reference")</span> }
                        @if (draft.ExpressionColumn == entry.ColumnName) { <span class="dbi-fl" style="color:var(--accent-text);background:var(--accent-soft)">@T("expression")</span> }
                        <label style="display:flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:var(--text-2);cursor:pointer;white-space:nowrap">
                          <input type="checkbox" checked="@draft.NaturalKey.Contains(entry.ColumnName)" @onchange="() => State.ToggleNaturalKey(draft, entry.ColumnName)" />
                          🔑 @T("key")
                        </label>
                      }
                    </div>
                  </div>
                }
              </div>
            }
            else
            {
              <div class="dbi-note"><span style="color:var(--info);font-size:14px">ⓘ</span><div>@T("pickTableNote")</div></div>
            }
          }
        </div>
      }

      @* ---------- STEP 3: VALIDATE ---------- *@
      else if (State.Step == 2)
      {
        IReadOnlyList<ValidationVm> checks = State.Validate();
        bool anyIssue = checks.Any(c => c.WouldSkip > 0 || c.MissingRequired.Count > 0);
        <div class="dbi-fade">
          <div style="margin-bottom:18px">
            <h1 class="dbi-h1">@T("s3Title")</h1>
            <p class="dbi-sub">@T("s3Sub")</p>
          </div>

          @if (!anyIssue)
          {
            <div class="dbi-status ok" style="margin-bottom:14px"><span>✓</span>@T("allValid")</div>
          }

          <div style="display:flex;flex-direction:column;gap:12px">
            @foreach (ValidationVm c in checks)
            {
              <div class="dbi-card">
                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                  <div style="font-weight:600;font-size:13.5px;min-width:150px">@c.Worksheet <span class="mono" style="font-weight:500;color:var(--text-3)">→ @c.Table</span></div>
                  <div class="dbi-status ok"><span>✓</span>@State.FmtInt(c.WouldImport) @T("willImport")</div>
                  @if (c.WouldSkip > 0)
                  {
                    <div class="dbi-status warn"><span>⚠</span>@State.FmtInt(c.WouldSkip) @T("willSkip")</div>
                  }
                  <div style="flex:1"></div>
                  <span class="mono" style="font-size:11.5px;color:var(--text-3)">@State.FmtInt(c.Rows) @T("rows")</span>
                </div>
                @if (c.MissingRequired.Count > 0)
                {
                  <div style="margin-top:10px;font-size:12px;color:var(--err);display:flex;align-items:center;gap:7px">
                    <span>●</span>@T("missingReq") <span class="mono">@string.Join(", ", c.MissingRequired)</span>
                  </div>
                }
                @if (c.UnmappedHeaders.Count > 0)
                {
                  <div style="margin-top:8px;font-size:11.5px;color:var(--text-3)">@T("unmapped"): <span class="mono">@string.Join(", ", c.UnmappedHeaders)</span></div>
                }
              </div>
            }
          </div>
          <div class="dbi-note"><span style="color:var(--info);font-size:14px">ⓘ</span><div>@T("skipNote")</div></div>
        </div>
      }

      @* ---------- STEP 4: LOAD ---------- *@
      else if (State.Step == 3)
      {
        <div class="dbi-fade" style="max-width:660px;margin:0 auto">
          <div style="margin-bottom:18px">
            <h1 class="dbi-h1">@T("s4Title")</h1>
            <p class="dbi-sub">@T("s4Sub")</p>
          </div>

          <div class="dbi-card" style="margin-bottom:16px">
            <div class="dbi-card-h"><span style="color:var(--accent)">◎</span>@T("willHappen")</div>
            <div class="dbi-kv">
              <div class="dbi-kv-cell"><div style="font-size:11px;color:var(--text-3)">@T("rowsToLoad")</div><div class="mono" style="font-weight:600;margin-top:3px">@State.FmtInt(State.TotalRows)</div></div>
              <div class="dbi-kv-cell"><div style="font-size:11px;color:var(--text-3)">@T("intoTables")</div><div class="mono dbi-ell" style="font-weight:600;margin-top:3px">@string.Join(", ", State.TargetTables)</div></div>
              <div class="dbi-kv-cell"><div style="font-size:11px;color:var(--text-3)">@T("target")</div><div style="font-weight:600;margin-top:3px">@T("targetDb")</div></div>
              <div class="dbi-kv-cell"><div style="font-size:11px;color:var(--text-3)">@T("changeSet")</div><div style="font-weight:600;margin-top:3px">Import</div></div>
            </div>
          </div>

          @if (State.LoadError is not null)
          {
            <div class="dbi-status err" role="alert" style="margin-bottom:14px"><span>⚠</span>@State.LoadError</div>
          }

          @if (State.Loading)
          {
            <div class="dbi-card" style="margin-bottom:14px">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                <div style="display:flex;align-items:center;gap:9px;font-weight:600"><span class="dbi-spin"></span>@T("loading")</div>
                <span class="mono" style="color:var(--text-2)">@($"{State.FmtInt(State.RowsDone)} / {State.FmtInt(State.TotalRows)}")</span>
              </div>
              <div class="dbi-bar" role="progressbar" aria-valuenow="@State.Progress" aria-valuemin="0" aria-valuemax="100"><div class="dbi-bar-fill" style="width:@(State.Progress)%"></div></div>
            </div>
            <button class="dbi-act" @onclick="State.Cancel">✕ @T("cancel")</button>
          }
          else if (State.Cancelled)
          {
            <div class="dbi-status warn" style="margin-bottom:14px"><span>⚠</span>@T("importCancelled") · @State.FmtInt(State.Report?.TotalCreated + State.Report?.TotalUpdated ?? 0) @T("rowsImported")</div>
            <div class="dbi-note" style="margin-bottom:14px"><span style="color:var(--info);font-size:14px">ⓘ</span><div>@T("cancelledNote")</div></div>
            <div style="display:flex;gap:12px">
              <button class="dbi-act primary" @onclick="State.GotoRecap">@T("viewRecap")</button>
              <button class="dbi-act" @onclick="State.StartNew">＋ @T("startNew")</button>
            </div>
          }
          else
          {
            <button class="dbi-bigbtn" disabled="@(State.TotalRows == 0 || !State.CanImport)" @onclick="State.RunImportAsync">▶ @T("confirmLoad")</button>
          }
        </div>
      }

      @* ---------- STEP 5: RECAP ---------- *@
      else if (State.Step == 4)
      {
        ImportReport? rep = State.Report;
        <div class="dbi-fade">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:5px"><span class="dbi-okdot">✓</span><h1 class="dbi-h1" style="margin:0">@T("s5Title")</h1></div>
          <p class="dbi-sub" style="margin-bottom:18px">@T("s5Sub")</p>

          @if (rep is null)
          {
            <div class="dbi-status warn"><span>⚠</span>@T("nothingLoaded")</div>
          }
          else
          {
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px">
              <div class="dbi-metric"><div style="font-size:12px;font-weight:600;color:var(--text-2)">@T("created")</div><div class="mono" style="font-size:28px;font-weight:700;color:var(--ok);margin-top:5px">@State.FmtInt(rep.TotalCreated)</div></div>
              <div class="dbi-metric"><div style="font-size:12px;font-weight:600;color:var(--text-2)">@T("updated")</div><div class="mono" style="font-size:28px;font-weight:700;color:var(--info);margin-top:5px">@State.FmtInt(rep.TotalUpdated)</div></div>
              <div class="dbi-metric"><div style="font-size:12px;font-weight:600;color:var(--text-2)">@T("skipped")</div><div class="mono" style="font-size:28px;font-weight:700;color:var(--warn);margin-top:5px">@State.FmtInt(rep.TotalSkipped)</div></div>
              <div class="dbi-metric"><div style="font-size:12px;font-weight:600;color:var(--text-2)">@T("warnings")</div><div class="mono" style="font-size:28px;font-weight:700;color:@(rep.TotalWarnings > 0 ? "var(--warn)" : "var(--text-3)");margin-top:5px">@State.FmtInt(rep.TotalWarnings)</div></div>
            </div>

            <div class="dbi-card" style="padding:0;overflow:hidden;margin-bottom:16px">
              <div style="overflow-x:auto" class="dbi-scroll">
                <table class="dbi-log">
                  <thead><tr>
                    <th>@T("stepSource")</th><th>@T("table")</th>
                    <th style="text-align:right">@T("created")</th><th style="text-align:right">@T("updated")</th>
                    <th style="text-align:right">@T("skipped")</th><th style="text-align:right">@T("resolved")</th>
                    <th style="text-align:right">@T("unresolved")</th><th>@T("unmapped")</th>
                  </tr></thead>
                  <tbody>
                    @foreach (WorksheetReport w in rep.Worksheets.Where(w => w.Created + w.Updated + w.Skipped > 0 || w.UnmappedColumns.Count > 0))
                    {
                      <tr>
                        <td style="color:var(--text-2)">@w.Worksheet</td>
                        <td class="mono" style="color:var(--text)">@w.Table</td>
                        <td class="mono" style="text-align:right;color:var(--ok)">@w.Created</td>
                        <td class="mono" style="text-align:right;color:var(--info)">@w.Updated</td>
                        <td class="mono" style="text-align:right;color:@(w.Skipped > 0 ? "var(--warn)" : "var(--text-3)")">@w.Skipped</td>
                        <td class="mono" style="text-align:right;color:var(--text-2)">@w.ResolvedReferences</td>
                        <td class="mono" style="text-align:right;color:@(w.UnresolvedReferences > 0 ? "var(--err)" : "var(--text-3)")">@w.UnresolvedReferences</td>
                        <td class="mono dbi-ell" style="color:var(--text-3);max-width:180px">@string.Join(", ", w.UnmappedColumns)</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>

            @if (RecapIssues().Count > 0)
            {
              <div class="dbi-card" style="margin-bottom:16px">
                <div class="dbi-card-h"><span style="color:var(--warn)">⚠</span>@T("rejections")</div>
                @foreach (WorksheetReport w in RecapIssues())
                {
                  <div style="margin-bottom:10px">
                    <div style="font-weight:600;font-size:12.5px;margin-bottom:4px">@w.Worksheet <span class="mono" style="color:var(--text-3);font-weight:500">→ @w.Table</span></div>
                    @foreach (string msg in w.Errors.Take(8))
                    {
                      <div style="font-size:11.5px;color:var(--err);display:flex;gap:6px"><span>✕</span><span class="dbi-ell">@msg</span></div>
                    }
                    @foreach (string msg in w.Warnings.Take(8))
                    {
                      <div style="font-size:11.5px;color:var(--warn);display:flex;gap:6px"><span>⚠</span><span class="dbi-ell">@msg</span></div>
                    }
                    @if (w.Errors.Count + w.Warnings.Count > 16)
                    {
                      <div style="font-size:11px;color:var(--text-3);margin-top:2px">… +@(w.Errors.Count + w.Warnings.Count - 16) @T("more")</div>
                    }
                  </div>
                }
              </div>
            }
          }

          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <div style="flex:1"></div>
            <button class="dbi-act primary" @onclick="State.StartNew">＋ @T("startNew")</button>
          </div>
        </div>
      }

    </div>
  </main>

  @* ===== FOOTER ===== *@
  <footer class="dbi-foot">
    <button class="dbi-back" disabled="@(State.Step == 0)" @onclick="State.GoBack">← @T("back")</button>
    <div style="flex:1;display:flex;align-items:center;gap:10px;color:var(--text-3);font-size:12px">
      <span class="mono">@($"{State.Step + 1} / {DataImportState.StepCount}")</span>
    </div>
    @if (State.Step < DataImportState.StepCount - 1)
    {
      <button class="dbi-next" disabled="@NextDisabled()" @onclick="OnNext">@NextLabel() →</button>
    }
  </footer>
</div>

@code {
    private string? _mapSheet;
    private string? _saveName;
    private string? _savedSelect;

    private string T(string k) => State.T(k);

    private string[] _labels => [T("stepSource"), T("stepMapping"), T("stepValidate"), T("stepLoad"), T("stepRecap")];
    private string[] _kickers => [T("kSource"), T("kMapping"), T("kValidate"), T("kLoad"), T("kRecap")];

    private SheetMappingDraft? ActiveDraft()
    {
        SheetMappingDraft? draft = State.Drafts.FirstOrDefault(d => d.Sheet == _mapSheet) ?? State.Drafts.FirstOrDefault();
        _mapSheet = draft?.Sheet;
        return draft;
    }

    /// <summary>First non-empty value of a header (first 20 rows only — keeps large sheets render-cheap).</summary>
    private string? SampleFor(string sheet, string header)
        => State.SheetFor(sheet)?.Rows.Take(20).Select(r => r.GetValueOrDefault(header)).FirstOrDefault(v => !string.IsNullOrEmpty(v));

    private bool NextDisabled() => State.Step switch
    {
        0 => !State.HasFile,
        1 => !State.MappingReady,
        3 => true, // the Load step advances via the import button, not Next
        _ => false,
    };

    private string NextLabel() => State.Step switch
    {
        1 => T("runValidation"),
        2 => T("goLoad"),
        _ => T("next"),
    };

    private void OnNext() => State.GoNext();

    private IReadOnlyList<WorksheetReport> RecapIssues()
        => State.Report?.Worksheets.Where(w => w.Errors.Count > 0 || w.Warnings.Count > 0).ToList() ?? [];

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        if (file.Size > DataImportState.MaxFileBytes)
        {
            State.RejectTooLarge(); // reject before opening a too-large stream
            return;
        }

        await using Stream stream = file.OpenReadStream(maxAllowedSize: DataImportState.MaxFileBytes);
        await State.LoadFileAsync(file.Name, file.Size, stream);
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        Lang.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        Lang.OnChange -= OnStateChanged;
    }
}
