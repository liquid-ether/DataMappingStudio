@inject MappingStudioState State
@inject LanguageState Lang
@implements IDisposable
@using App.Application.Lineage
@using App.Domain.Entities
@using App.UI.MappingStudio

@* Mappings grid backed by the local store. Uses a virtualized QuickGrid so thousands of mapping rows
   render without lag; rows carry inline kind/target/type badges (click to cycle) and the expression
   editor. Filter by target or search to narrow the set. *@
@{
    IReadOnlyList<(MappingRow Row, int Index)> visible = State.VisibleRows(_search, _targetFilter);
}
<div class="toolbar">
    <label class="search"><span class="mag">⌕</span>
        <input type="text" placeholder="@Lang.T("search")" value="@_search" @oninput="e => _search = e.Value?.ToString() ?? string.Empty" /></label>
    <span class="filt">@Lang.T("tabMappings")
        <select value="@_targetFilter" @onchange="OnTargetFilterChanged">
            <option value="*">@(Lang.IsFrench ? "Toutes" : "All")</option>
            @foreach (string t in State.TargetNames)
            {
                <option value="@t">@t</option>
            }
        </select></span>
    <span class="count">@visible.Count mappings</span>
</div>

<div class="gridbox">
    <QuickGrid Items="@visible.Select(v => v.Row).AsQueryable()" Virtualize="@GridVirtualize" ItemSize="34" Class="quickgrid">
        <TemplateColumn Title="Kind">
            <div class="cell pickable"><span class="kind-badge @context.Kind.ToString().ToLowerInvariant()" @onclick="() => CycleKind(context)">@KindLabel(context.Kind)</span></div>
        </TemplateColumn>
        <TemplateColumn Title="Target">
            <div class="cell pickable" @onclick="() => CycleTarget(context)"><span class="mono" style="font-size:12px;color:var(--ink-soft)">@context.Target</span></div>
        </TemplateColumn>
        <TemplateColumn Title="Field">
            @if (context.ProducesField)
            {
                <div class="cell editable"><input class="gi fld" value="@context.Field" @onchange="e => OnFieldChanged(context, e.Value?.ToString())" /></div>
            }
            else
            {
                <div class="cell muted">—</div>
            }
        </TemplateColumn>
        <TemplateColumn Title="Expression">
            <ExpressionEditor Expression="@context.Expression" Refs="@State.KnownReferences(context.Target)" OnCommit="v => OnExpressionChanged(context, v)" />
        </TemplateColumn>
        <TemplateColumn Title="Type">
            @if (context.ProducesField)
            {
                <div class="cell pickable"><span class="type-badge" @onclick="() => CycleType(context)">@(string.IsNullOrEmpty(context.Type) ? "text" : context.Type)</span></div>
            }
            else
            {
                <div class="cell muted">—</div>
            }
        </TemplateColumn>
        <TemplateColumn Title="">
            <div class="cell"><span class="rowx" title="remove" @onclick="() => State.DeleteRow(context)">✕</span></div>
        </TemplateColumn>
    </QuickGrid>
</div>

<div class="addbar">
    <span class="lab">@(Lang.IsFrench ? "Ajouter à" : "Add to")</span>
    <select value="@_addTarget" @onchange="OnAddTargetChanged">
        @foreach (string t in State.TargetNames)
        {
            <option value="@t">@t</option>
        }
    </select>
    <button class="add" @onclick="() => State.AddRow(MappingKind.Field, _addTarget)"><span class="plus">+</span> Field</button>
    <button class="add" @onclick="() => State.AddRow(MappingKind.Calc, _addTarget)"><span class="plus">+</span> Calculated</button>
    <button class="add" @onclick="() => State.AddRow(MappingKind.Join, _addTarget)"><span class="plus">+</span> Join</button>
    <button class="add" @onclick="() => State.AddRow(MappingKind.Filter, _addTarget)"><span class="plus">+</span> Filter</button>
</div>

@code {
    // Virtualize by default; tests cascade false so QuickGrid renders all rows without JS.
    [CascadingParameter(Name = "GridVirtualize")] public bool GridVirtualize { get; set; } = true;

    private string _search = string.Empty;
    private string _targetFilter = "*";
    private string _addTarget = string.Empty;

    protected override void OnInitialized()
    {
        _addTarget = State.TargetNames.FirstOrDefault() ?? string.Empty;
        Lang.OnChange += StateHasChanged;
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;

    private void OnTargetFilterChanged(ChangeEventArgs e) => _targetFilter = e.Value?.ToString() ?? "*";

    private void OnAddTargetChanged(ChangeEventArgs e) => _addTarget = e.Value?.ToString() ?? State.TargetNames.FirstOrDefault() ?? string.Empty;

    private static string KindLabel(MappingKind kind) => kind switch
    {
        MappingKind.Calc => "Calculated",
        MappingKind.Join => "Join",
        MappingKind.Filter => "Filter",
        _ => "Field",
    };

    private void OnFieldChanged(MappingRow row, string? value)
    {
        row.Field = value ?? string.Empty;
        State.Save(row);
    }

    private void OnExpressionChanged(MappingRow row, string value)
    {
        row.Expression = value;
        State.Save(row);
    }

    private void CycleKind(MappingRow row)
    {
        row.Kind = row.Kind switch
        {
            MappingKind.Field => MappingKind.Calc,
            MappingKind.Calc => MappingKind.Join,
            MappingKind.Join => MappingKind.Filter,
            _ => MappingKind.Field,
        };

        if (!row.ProducesField)
        {
            row.Field = string.Empty;
            row.Type = string.Empty;
        }
        else if (string.IsNullOrEmpty(row.Type))
        {
            row.Type = "text";
        }

        State.Save(row);
    }

    private void CycleTarget(MappingRow row)
    {
        IReadOnlyList<string> names = State.TargetNames;
        if (names.Count == 0)
        {
            return;
        }

        row.Target = names[(names.ToList().IndexOf(row.Target) + 1) % names.Count];
        State.Save(row);
    }

    private void CycleType(MappingRow row)
    {
        string[] types = ["text", "number", "date", "bool"];
        string current = string.IsNullOrEmpty(row.Type) ? "text" : row.Type;
        row.Type = types[(Array.IndexOf(types, current) + 1) % types.Length];
        State.Save(row);
    }
}
