@implements IDisposable
@inject ICatalog Catalog
@inject ILocalStore Store
@inject LanguageState Lang
@inject IServiceProvider Services
@using App.Application.References
@using Microsoft.Extensions.DependencyInjection

@* Metadata-driven editor: columns and rows render from the column catalog, so a new column appears
   with no code change (Architecture §4). Rows render in a virtualized QuickGrid so large tables (e.g.
   thousands of dictionary entries) stay responsive. Inline edit + add-row + add-column + validation. *@
<div class="toolbar">
    <h2 class="page-title">@Title</h2>
    <span class="count">@_rows.Count</span>
</div>

<div class="gridbox">
    <QuickGrid Items="@_rows.AsQueryable()" Virtualize="@GridVirtualize" ItemSize="34" Class="quickgrid">
        @foreach (ColumnCatalogEntry col in _columns)
        {
            ColumnCatalogEntry c = col;
            <TemplateColumn>
                <HeaderTemplate>@Lang.Label(c.LabelEn, c.LabelFr)@if (c.IsRequired) {<span class="req">*</span>}</HeaderTemplate>
                <ChildContent>
                    @if (c.Kind == ColumnKind.Computed && _computed is not null)
                    {
                        <div class="cell muted" title="computed">@ComputedValue(c, context)</div>
                    }
                    else if (c.Kind == ColumnKind.Reference && _refs is not null)
                    {
                        <div class="cell editable">
                            <select class="gi" value="@context[c.ColumnName]" @onchange="e => CommitCell(context, c, e.Value?.ToString())">
                                <option value="">—</option>
                                @foreach (ReferenceOption opt in RefOptions(c.ReferenceTarget!))
                                {
                                    <option value="@opt.Id">@opt.Display</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="cell editable">
                            <input class="gi @(IsInvalid(context, c) ? "invalid" : null)"
                                   value="@context[c.ColumnName]"
                                   @onchange="e => CommitCell(context, c, e.Value?.ToString())" />
                        </div>
                    }
                </ChildContent>
            </TemplateColumn>
        }
        <TemplateColumn Title="">
            <div class="cell"><span class="rowx" title="remove" @onclick="() => DeleteRow(context)">✕</span></div>
        </TemplateColumn>
    </QuickGrid>
</div>

@if (_rows.Count == 0 && _draft is null)
{
    <div class="cell muted" style="padding:12px">@Lang.T("noRows")</div>
}

@if (_draft is not null)
{
    <div class="draftbar">
        @foreach (ColumnCatalogEntry col in _columns)
        {
            ColumnCatalogEntry c = col;
            @if (c.Kind == ColumnKind.Reference && _refs is not null)
            {
                <select class="gi" value="@_draft[c.ColumnName]" @onchange="e => _draft[c.ColumnName] = Blank(e.Value?.ToString())">
                    <option value="">@Lang.Label(c.LabelEn, c.LabelFr)</option>
                    @foreach (ReferenceOption opt in RefOptions(c.ReferenceTarget!))
                    {
                        <option value="@opt.Id">@opt.Display</option>
                    }
                </select>
            }
            else if (c.Kind != ColumnKind.Computed)
            {
                <input class="gi" placeholder="@Lang.Label(c.LabelEn, c.LabelFr)"
                       value="@_draft[c.ColumnName]"
                       @onchange="e => _draft[c.ColumnName] = Blank(e.Value?.ToString())" />
            }
        }
    </div>
}

@if (_error is not null)
{
    <div class="err">@_error</div>
}

<div class="addbar">
    @if (_draft is null)
    {
        <button class="add" type="button" @onclick="StartDraft"><span class="plus">+</span> @Lang.T("addRow")</button>
    }
    else
    {
        <button class="ms-publish" type="button" @onclick="SaveDraft">@Lang.T("save")</button>
        <button class="add" type="button" @onclick="CancelDraft">@Lang.T("cancel")</button>
    }

    @if (_addingColumn)
    {
        <input class="ed-input" style="width:160px" placeholder="@Lang.T("columnName")" @bind="_newColumnName" />
        <select class="ed-select" style="width:120px" @bind="_newColumnType">
            @foreach (CatalogValueType t in Enum.GetValues<CatalogValueType>())
            {
                <option value="@t">@t</option>
            }
        </select>
        <button class="ms-publish" type="button" @onclick="ConfirmAddColumn">@Lang.T("save")</button>
        <button class="add" type="button" @onclick="() => _addingColumn = false">@Lang.T("cancel")</button>
    }
    else
    {
        <button class="add" type="button" @onclick="() => _addingColumn = true"><span class="plus">+</span> @Lang.T("addColumn")</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Table { get; set; } = string.Empty;

    [Parameter] public string ChangedBy { get; set; } = "analyst";

    [Parameter] public string? Title { get; set; }

    // Virtualize by default; tests cascade false so QuickGrid renders all rows without JS.
    [CascadingParameter(Name = "GridVirtualize")] public bool GridVirtualize { get; set; } = true;

    private IReadOnlyList<ColumnCatalogEntry> _columns = [];
    private List<Row> _rows = [];

    // Reference options and computed values are derived once per load and reused across every cell
    // render (QuickGrid re-renders visible rows on each scroll). Without this cache each reference cell
    // re-queried its target table and each computed cell re-scanned a child table per row, which made
    // the Sources/Dictionary grids stall for seconds while scrolling the sample dataset.
    private Dictionary<string, IReadOnlyList<ReferenceOption>> _refOptions = new(StringComparer.Ordinal);
    private Dictionary<string, Dictionary<Guid, string?>> _computedValues = new(StringComparer.Ordinal);

    private Row? _draft;
    private string? _error;
    private bool _addingColumn;
    private string _newColumnName = string.Empty;
    private CatalogValueType _newColumnType = CatalogValueType.Text;

    // Optional: present in the hosts (reference pickers + computed-column autofill), absent in plain tests.
    private IReferenceResolver? _refs;
    private IComputedEvaluator? _computed;

    protected override void OnInitialized()
    {
        _refs = Services.GetService<IReferenceResolver>();
        _computed = Services.GetService<IComputedEvaluator>();
        Lang.OnChange += StateHasChanged;
    }

    protected override void OnParametersSet() => Reload();

    public void Dispose() => Lang.OnChange -= StateHasChanged;

    private void Reload()
    {
        _columns = Catalog.GetForTable(Table)
            .Where(e => !e.IsCore && !IsCore(e.ColumnName))
            .OrderBy(e => e.DisplayOrder).ThenBy(e => e.ColumnName)
            .ToList();
        _rows = Store.GetAll(Table).ToList();

        // Read each referenced table once for its picker options...
        _refOptions = _columns
            .Where(c => c.Kind == ColumnKind.Reference && c.ReferenceTarget is not null)
            .Select(c => c.ReferenceTarget!)
            .Distinct(StringComparer.Ordinal)
            .ToDictionary(t => t, t => _refs?.Options(t) ?? [], StringComparer.Ordinal);

        // ...and evaluate each computed column in one bulk pass (one child/target read for all rows).
        _computedValues = _computed is null
            ? new(StringComparer.Ordinal)
            : _columns
                .Where(c => c.Kind == ColumnKind.Computed)
                .ToDictionary(
                    c => c.ColumnName,
                    c => new Dictionary<Guid, string?>(_computed.EvaluateColumn(Table, c.ColumnName, _rows)),
                    StringComparer.Ordinal);
    }

    private IReadOnlyList<ReferenceOption> RefOptions(string target)
        => _refOptions.TryGetValue(target, out IReadOnlyList<ReferenceOption>? opts) ? opts : [];

    private string? ComputedValue(ColumnCatalogEntry col, Row row)
        => _computedValues.TryGetValue(col.ColumnName, out Dictionary<Guid, string?>? map) && map.TryGetValue(row.Id, out string? v)
            ? v
            : null;

    private void CommitCell(Row row, ColumnCatalogEntry col, string? value)
    {
        string? v = Blank(value);
        if (col.IsRequired && v is null)
        {
            row[col.ColumnName] = v; // keep empty so the invalid marker shows; do not persist
            return;
        }

        row[col.ColumnName] = v;
        Store.Upsert(Table, row, NewChangeSet(), ChangedBy);

        // Keep this row's computed cells (e.g. lookups off a reference) in sync with the edit without
        // a full reload — cheap, one row, and avoids losing the user's scroll position.
        if (_computed is not null && _computedValues.Count > 0)
        {
            foreach (ColumnCatalogEntry computed in _columns.Where(c => c.Kind == ColumnKind.Computed))
            {
                if (_computedValues.TryGetValue(computed.ColumnName, out Dictionary<Guid, string?>? map))
                {
                    map[row.Id] = _computed.EvaluateColumn(Table, computed.ColumnName, [row]).GetValueOrDefault(row.Id);
                }
            }
        }
    }

    private void StartDraft()
    {
        _error = null;
        _draft = new Row(Table, Guid.NewGuid());
    }

    private void CancelDraft()
    {
        _draft = null;
        _error = null;
    }

    private void SaveDraft()
    {
        if (_draft is null)
        {
            return;
        }

        if (_columns.Any(c => c.IsRequired && _draft[c.ColumnName] is null))
        {
            _error = Lang.T("requiredMissing");
            return;
        }

        Store.Upsert(Table, _draft, NewChangeSet(), ChangedBy);
        _draft = null;
        _error = null;
        Reload();
    }

    private void DeleteRow(Row row)
    {
        Store.SoftDelete(Table, row.Id, NewChangeSet(), ChangedBy);
        Reload();
    }

    private void ConfirmAddColumn()
    {
        string name = _newColumnName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        Catalog.AddColumn(new ColumnCatalogEntry
        {
            TableName = Table,
            ColumnName = name,
            ValueType = _newColumnType,
            LabelEn = name,
            LabelFr = name,
            IsUserAdded = true,
            DisplayOrder = _columns.Count + 1,
        });

        _addingColumn = false;
        _newColumnName = string.Empty;
        Reload();
    }

    private bool IsInvalid(Row row, ColumnCatalogEntry col) => col.IsRequired && row[col.ColumnName] is null;

    private static bool IsCore(string column) =>
        column is SyncColumns.Id or SyncColumns.RowVersion or SyncColumns.BaseVersion
            or SyncColumns.ModifiedAt or SyncColumns.ModifiedBy or SyncColumns.IsDeleted;

    private static string? Blank(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private static string NewChangeSet() => Guid.NewGuid().ToString();
}
