@implements IDisposable
@inject LanguageState Lang
@inject ThemeState Theme
@inject ICurrentUser User
@inject IServiceProvider Services

@* App chrome: brand, EN/FR toggle, theme palette + light/dark, Publish (with pending badge), account
   area. Navigation lives in MsSideNav — the top bar stays fixed-size however many destinations exist. *@
<div class="ms-top">
    <div class="ms-brand"><span class="glyph">⇲</span><span>@Lang.T("brand")</span></div>
    <div class="ms-spacer"></div>
    @if (_remoteDown)
    {
        <span title="@(Lang.IsFrench ? "Dossier partagé indisponible — publication/synchronisation en pause" : "Shared folder unavailable — publish/sync paused")"
              style="color:var(--warn);font-size:15px" role="status">⚠</span>
    }
    <div class="ms-lang" role="group" aria-label="Language">
        <button type="button" aria-pressed="@(!Lang.IsFrench)" @onclick='() => Lang.Set("en")'>EN</button>
        <button type="button" aria-pressed="@Lang.IsFrench" @onclick='() => Lang.Set("fr")'>FR</button>
    </div>
    <select class="ms-theme-pick" title="@(Lang.IsFrench ? "Palette de couleurs" : "Colour palette")"
            value="@Theme.Palette" @onchange="e => Theme.SetPaletteAsync((string)e.Value!)">
        <option value="teal">@(Lang.IsFrench ? "Sarcelle" : "Teal")</option>
        <option value="indigo">Indigo</option>
        <option value="graphite">Graphite</option>
        <option value="ocean">@(Lang.IsFrench ? "Océan" : "Ocean")</option>
        <option value="paper">@(Lang.IsFrench ? "Papier" : "Paper")</option>
    </select>
    <button class="ms-theme" type="button" title="@(Theme.IsDark ? "Light theme" : "Dark theme")"
            aria-pressed="@Theme.IsDark" @onclick="Theme.ToggleAsync">@(Theme.IsDark ? "☀" : "☾")</button>
    @if (User.HasPermission(Permissions.DataPublish))
    {
        <button class="ms-publish" type="button" @onclick="OnPublish">@Lang.T("publish")@(_pending > 0 ? $" ({_pending})" : null)</button>
    }
    @AccountArea
</div>

@code {
    [Parameter] public EventCallback OnPublish { get; set; }

    /// <summary>Optional host-supplied account controls (web: current user + Admin + sign out; desktop: none).</summary>
    [Parameter] public RenderFragment? AccountArea { get; set; }

    private int _pending;
    private bool _remoteDown;

    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
        Theme.OnChange += StateHasChanged;
    }

    protected override void OnParametersSet()
    {
        // Refresh the badge + remote-health hint on every render (navigation re-renders the layout).
        // Resolved lazily: test hosts may not register a coordinator, and a store error must never
        // break the chrome.
        try
        {
            if (Services.GetService(typeof(ISyncCoordinator)) is ISyncCoordinator sync)
            {
                _pending = sync.PendingCount();
                _remoteDown = !sync.RemoteStatus.Available;
            }
        }
        catch
        {
            _pending = 0;
            _remoteDown = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS interop is only available post-render; sync our state to the theme the host page
            // already applied to <html> so the picker + toggle show the right values.
            await Theme.EnsureInitializedAsync();
        }
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
        Theme.OnChange -= StateHasChanged;
    }
}
