@implements IDisposable
@inject LanguageState Lang

@* Dark top bar from the mockup: brand glyph, primary tabs, EN/FR toggle, Publish. *@
<div class="ms-top">
    <div class="ms-brand"><span class="glyph">⇲</span><span>@Lang.T("brand")</span></div>
    <nav class="ms-tabs">
        @foreach ((string Href, string Key) tab in Tabs)
        {
            @if (OnSelect.HasDelegate)
            {
                @* Desktop (non-routed) shell: tabs switch an in-app view instead of navigating a URL. *@
                <button type="button" aria-selected="@(tab.Href == ActiveHref)" @onclick="() => OnSelect.InvokeAsync(tab.Href)">@Lang.T(tab.Key)</button>
            }
            else
            {
                <NavLink class="@(tab.Href == "" ? "active" : null)" href="@tab.Href" Match="NavLinkMatch.All" ActiveClass="active">@Lang.T(tab.Key)</NavLink>
            }
        }
    </nav>
    <div class="ms-spacer"></div>
    <div class="ms-lang" role="group" aria-label="Language">
        <button type="button" aria-pressed="@(!Lang.IsFrench)" @onclick='() => Lang.Set("en")'>EN</button>
        <button type="button" aria-pressed="@Lang.IsFrench" @onclick='() => Lang.Set("fr")'>FR</button>
    </div>
    <button class="ms-publish" type="button" @onclick="OnPublish">@Lang.T("publish")</button>
</div>

@code {
    /// <summary>Top-level navigation tabs (href, i18n key).</summary>
    [Parameter] public IReadOnlyList<(string Href, string Key)> Tabs { get; set; } =
    [
        ("applications", "navApplications"),
        ("sources", "navSources"),
        ("dictionary", "navDictionary"),
        ("config", "navConfig"),
        ("classification", "navClassification"),
        ("rules", "navRules"),
        ("mappings", "tabMappings"),
        ("lineage", "tabLineage"),
    ];

    [Parameter] public EventCallback OnPublish { get; set; }

    /// <summary>When set (desktop shell), tabs become buttons that raise this with the tab's Href key
    /// instead of navigating a URL. When unset (web), tabs render as routed <see cref="NavLink"/>s.</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>The currently active tab's Href, used to mark the active button in desktop mode.</summary>
    [Parameter] public string? ActiveHref { get; set; }

    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;

    public void Dispose() => Lang.OnChange -= StateHasChanged;
}
