@namespace App.UI
@using App.Application.Provisioning
@implements IDisposable

@* Root component for the Blazor Hybrid desktop shell. Blazor Hybrid has no URL router, so this is a
   non-routed view switcher: the top bar's tabs select an in-app view, rendering the same App.UI
   components the web host routes to (Architecture §5a — one component tree serves both hosts). *@
<MsTopBar Tabs="_tabs" ActiveHref="@_active" OnSelect="Select" OnPublish="ShowPublish" />

<div class="ms-wrap">
    @if (_active == "mappings")
    {
        <MappingGrid />
    }
    else if (_active == "lineage")
    {
        <LineageView />
    }
    else if (_active == "import")
    {
        <DataImportWizard />
    }
    else if (_active == "history")
    {
        <HistoryView />
    }
    else if (_active == "publish")
    {
        <PublishPanel />
    }
    else if (_active.StartsWith("t/", StringComparison.Ordinal))
    {
        string table = _active["t/".Length..];
        <MetadataGrid Table="@table" Title="@TitleFor(table)" />
    }
</div>

@code {
    [Inject] public LanguageState Lang { get; set; } = default!;

    // Entity tabs are data-driven from the catalog navigation, then Mapping Studio, Lineage and History —
    // mirroring the web host's MainLayout so both shells expose the same destinations.
    private static readonly IReadOnlyList<(string Href, string Key)> _tabs =
    [
        .. DefaultCatalog.Navigation.Select(n => ($"t/{n.Table}", n.NavKey)),
        ("mappings", "tabMappings"),
        ("lineage", "tabLineage"),
        ("import", "navImport"),
        ("history", "navHistory"),
    ];

    private string _active = $"t/{DefaultCatalog.Navigation[0].Table}";

    private void Select(string href) => _active = href;

    private void ShowPublish() => _active = "publish";

    private string TitleFor(string table)
    {
        EntityNav? nav = DefaultCatalog.Navigation.FirstOrDefault(n => n.Table == table);
        return nav is null ? table : Lang.T(nav.NavKey);
    }

    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;

    public void Dispose() => Lang.OnChange -= StateHasChanged;
}
