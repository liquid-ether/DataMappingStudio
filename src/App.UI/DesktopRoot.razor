@namespace App.UI
@using App.Application.Provisioning
@implements IDisposable

@* Root component for the Blazor Hybrid desktop shell. Blazor Hybrid has no URL router, so this is a
   non-routed view switcher: the side navigation selects an in-app view, rendering the same App.UI
   components the web host routes to (Architecture §5a — one component tree serves both hosts). *@
<MsTopBar OnPublish="ShowPublish" />

<div class="ms-body">
    <MsSideNav Sections="_sections" ActiveHref="@_active" OnSelect="Select" />
    <div class="ms-wrap">
        @if (_active == "mappings")
        {
            <MappingGrid />
        }
        else if (_active == "lineage")
        {
            <LineageView />
        }
        else if (_active == "import")
        {
            <DataImportWizard />
        }
        else if (_active == "history")
        {
            <HistoryView />
        }
        else if (_active == "publish")
        {
            <PublishPanel />
        }
        else if (_active.StartsWith("t/", StringComparison.Ordinal))
        {
            string table = _active["t/".Length..];
            <MetadataGrid Table="@table" Title="@TitleFor(table)" />
        }
    </div>
</div>

@code {
    [Inject] public LanguageState Lang { get; set; } = default!;

    [Inject] public IServiceProvider Services { get; set; } = default!;

    // Entity destinations are data-driven: the default catalog navigation plus runtime-created tables
    // (which arrive via catalog sync) — mirroring the web host's MainLayout so both shells expose the
    // same structure. The table catalog is optional so test hosts without one degrade to the defaults.
    private ITableCatalog? Tables => Services.GetService(typeof(ITableCatalog)) as ITableCatalog;

    private IReadOnlyList<NavSection> _sections = [];

    private string _active = $"t/{DefaultCatalog.Navigation[0].Table}";

    private void Select(string href)
    {
        _active = href;
        BuildSections(); // pick up tables that synced in since the last interaction
    }

    private void ShowPublish() => _active = "publish";

    private string TitleFor(string table) => App.UI.Navigation.EntityNavigation.TitleFor(table, Tables, Lang);

    private void BuildSections() => _sections =
    [
        new NavSection("Data model", "Modèle de données", App.UI.Navigation.EntityNavigation.EntityItems(Tables)),
        new NavSection("Studio", "Studio",
            [new NavItem("mappings", "tabMappings"), new NavItem("lineage", "tabLineage")]),
        new NavSection("Tools", "Outils",
            [new NavItem("import", "navImport"), new NavItem("history", "navHistory")]),
    ];

    protected override void OnInitialized()
    {
        BuildSections();
        Lang.OnChange += StateHasChanged;
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;
}
