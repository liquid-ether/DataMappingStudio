@namespace App.UI

@* Root component for the Blazor Hybrid desktop shell. Renders the same App.UI components the web host
   uses, proving one component tree serves both hosts (Architecture §5a). Non-routed for now. *@
<MsTopBar Tabs="_tabs" />

<div class="ms-wrap">
    <MetadataGrid Table="@_table" Title="@Lang.T(_navKey)" />
</div>

@code {
    // Non-routed shell: a simple table switcher (full routing/pages are shared via App.Web today).
    [Inject] public LanguageState Lang { get; set; } = default!;

    private string _table = "application";
    private string _navKey = "navApplications";
    private IReadOnlyList<(string Href, string Key)> _tabs = [];
}
