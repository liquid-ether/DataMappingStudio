<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Apply the saved (or system-preferred) theme before first paint to avoid a flash. *@
    <script>
        window.dmsTheme = {
            get() { try { return localStorage.getItem('dms_theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch (e) { return 'light'; } },
            apply(t) { try { document.documentElement.setAttribute('data-theme', t); localStorage.setItem('dms_theme', t); } catch (e) { } }
        };
        document.documentElement.setAttribute('data-theme', window.dmsTheme.get());
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Load web fonts asynchronously so first paint is never blocked on the network; the fallbacks in
       app.css render immediately, then the real fonts swap in. *@
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="_content/App.UI/css/app.css" />
    <link rel="stylesheet" href="@Assets["App.Web.styles.css"]" />
    <ImportMap />
    <title>Mapping Studio</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
