@inherits LayoutComponentBase
@inject NavigationManager Nav

<MsTopBar Tabs="_tabs" OnPublish="GoToPublish" />

<div class="ms-wrap">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Entity tabs are data-driven from the catalog navigation, then the Mapping Studio + Lineage tabs.
    private static readonly IReadOnlyList<(string Href, string Key)> _tabs =
    [
        .. DefaultCatalog.Navigation.Select(n => ($"t/{n.Table}", n.NavKey)),
        ("mappings", "tabMappings"),
        ("lineage", "tabLineage"),
        ("import", "navImport"),
        ("history", "navHistory"),
    ];

    private void GoToPublish() => Nav.NavigateTo("publish");
}
