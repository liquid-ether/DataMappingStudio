@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ICurrentUser User
@inject LanguageState Lang

<MsTopBar Tabs="_tabs" OnPublish="GoToPublish">
    <AccountArea>
        @if (_authOn)
        {
            @if (User.HasPermission(Permissions.UsersManage) || User.HasPermission(Permissions.RolesManage) || User.HasPermission(Permissions.SecurityConfigure))
            {
                <a class="ms-tabs" style="text-decoration:none" href="admin/users">Admin</a>
            }
            <span class="muted" style="font-size:12px" title="@User.Name">@User.DisplayName</span>
            <form method="post" action="account/logout" style="margin:0">
                <AntiforgeryToken />
                <button class="add" type="submit">@(Lang.IsFrench ? "Déconnexion" : "Sign out")</button>
            </form>
        }
    </AccountArea>
</MsTopBar>

<div class="ms-wrap">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _authOn;

    // Entity tabs are data-driven from the catalog navigation, then the Mapping Studio + Lineage tabs.
    private static readonly IReadOnlyList<(string Href, string Key)> _tabs =
    [
        .. DefaultCatalog.Navigation.Select(n => ($"t/{n.Table}", n.NavKey)),
        ("mappings", "tabMappings"),
        ("lineage", "tabLineage"),
        ("import", "navImport"),
        ("history", "navHistory"),
    ];

    protected override void OnInitialized() => _authOn = Config.GetValue("Auth:Require", false);

    private void GoToPublish() => Nav.NavigateTo("publish");
}
