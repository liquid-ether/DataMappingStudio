@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ICurrentUser User
@inject LanguageState Lang

<MsTopBar OnPublish="GoToPublish">
    <AccountArea>
        @if (_authOn)
        {
            @if (User.HasPermission(Permissions.UsersManage) || User.HasPermission(Permissions.RolesManage) || User.HasPermission(Permissions.SecurityConfigure))
            {
                <a class="ms-tabs" style="text-decoration:none" href="admin">Admin</a>
            }
            <a class="ms-tabs" style="text-decoration:none;font-size:12px" href="account/password" title="@(Lang.IsFrench ? "Paramètres du compte" : "Account settings") — @User.Name">@User.DisplayName</a>
            <form method="post" action="account/logout" style="margin:0">
                <AntiforgeryToken />
                <button class="add" type="submit">@(Lang.IsFrench ? "Déconnexion" : "Sign out")</button>
            </form>
        }
    </AccountArea>
</MsTopBar>

<div class="ms-body">
    <MsSideNav Sections="_sections" />
    <div class="ms-wrap">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _authOn;

    // Side-nav sections: the data-driven entity editors, then the studio + tool destinations —
    // mirroring the desktop shell so both hosts expose the same structure.
    private static readonly IReadOnlyList<NavSection> _sections =
    [
        new NavSection("Data model", "Modèle de données",
            [.. DefaultCatalog.Navigation.Select(n => ($"t/{n.Table}", n.NavKey))]),
        new NavSection("Studio", "Studio",
            [("mappings", "tabMappings"), ("lineage", "tabLineage")]),
        new NavSection("Tools", "Outils",
            [("import", "navImport"), ("history", "navHistory")]),
    ];

    protected override void OnInitialized() => _authOn = Config.GetValue("Auth:Require", false);

    private void GoToPublish() => Nav.NavigateTo("publish");
}
