@inherits LayoutComponentBase

<MsTopBar Tabs="_tabs" />

<div class="ms-wrap">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // v0.6.0 ships the shell + one demo table; v0.7.0 replaces these with the entity tabs.
    private readonly IReadOnlyList<(string Href, string Key)> _tabs = [("t/widget", "navDemo")];
}
