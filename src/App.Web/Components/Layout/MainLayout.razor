@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ICurrentUser User
@inject LanguageState Lang
@inject ITableCatalog Tables
@using App.UI.Navigation

<MsTopBar OnPublish="GoToPublish">
    <AccountArea>
        @if (_authOn)
        {
            @if (User.HasPermission(Permissions.UsersManage) || User.HasPermission(Permissions.RolesManage)
                || User.HasPermission(Permissions.SecurityConfigure) || User.HasPermission(Permissions.ModelManage)
                || User.HasPermission(Permissions.AppConfigure))
            {
                <a class="ms-tabs" style="text-decoration:none" href="admin">Admin</a>
            }
            <a class="ms-tabs" style="text-decoration:none;font-size:12px" href="account/password" title="@(Lang.IsFrench ? "Paramètres du compte" : "Account settings") — @User.Name">@User.DisplayName</a>
            <form method="post" action="account/logout" style="margin:0">
                <AntiforgeryToken />
                <button class="add" type="submit">@(Lang.IsFrench ? "Déconnexion" : "Sign out")</button>
            </form>
        }
        else
        {
            @* Guest mode: the single local user is a full admin — meta-model + settings stay reachable. *@
            <a class="ms-tabs" style="text-decoration:none" href="admin/model">Admin</a>
        }
    </AccountArea>
</MsTopBar>

<div class="ms-body">
    <MsSideNav Sections="_sections" />
    <div class="ms-wrap">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _authOn;

    // Side-nav sections: the data-driven entity editors (defaults + runtime-created tables), then the
    // studio + tool destinations — mirroring the desktop shell so both hosts expose the same structure.
    // Rebuilt on every navigation (layouts persist; OnParametersSet fires per page), so a table created
    // in the admin appears in the nav on the next navigation.
    private IReadOnlyList<NavSection> _sections = [];

    protected override void OnInitialized() => _authOn = Config.GetValue("Auth:Require", false);

    protected override void OnParametersSet() => _sections =
    [
        new NavSection("Data model", "Modèle de données", EntityNavigation.EntityItems(Tables)),
        new NavSection("Studio", "Studio",
            [new NavItem("mappings", "tabMappings"), new NavItem("lineage", "tabLineage")]),
        new NavSection("Tools", "Outils",
            [new NavItem("import", "navImport"), new NavItem("history", "navHistory")]),
    ];

    private void GoToPublish() => Nav.NavigateTo("publish");
}
