@inherits LayoutComponentBase

<MsTopBar Tabs="_tabs" />

<div class="ms-wrap">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Entity tabs are data-driven from the catalog navigation; each links to the catalog-driven editor.
    private static readonly IReadOnlyList<(string Href, string Key)> _tabs =
        DefaultCatalog.Navigation.Select(n => ($"t/{n.Table}", n.NavKey)).ToList();
}
