@page "/"
@inject LanguageState Lang

<PageTitle>Mapping Studio</PageTitle>

<h1 class="page-title">@Lang.T("brand")</h1>
<p>@Lang.T("welcome")</p>
<div class="addbar">
    @foreach (EntityNav nav in DefaultCatalog.Navigation)
    {
        <a class="add" href="t/@nav.Table">@Lang.T(nav.NavKey)</a>
    }
</div>
